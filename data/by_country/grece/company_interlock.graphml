<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="n_label" for="node" attr.name="label" attr.type="string"/>
  <key id="n_sectors" for="node" attr.name="sectors" attr.type="string"/>
  <key id="n_n_directors" for="node" attr.name="n_directors" attr.type="long"/>
  <key id="n_territory" for="node" attr.name="territory" attr.type="string"/>
  <key id="e_weight" for="edge" attr.name="weight" attr.type="long"/>
  <graph id="G" edgedefault="undirected">
    <node id="canalcorinthe">
      <data key="n_label">Nouvelle Société du canal de Corinthe</data>
      <data key="n_sectors"></data>
      <data key="n_n_directors">31</data>
      <data key="n_territory">Grèce</data>
    </node>
    <node id="internationale">
      <data key="n_label">Société internationale, puis Société hellénique, puis Nouvelle Société du Canal maritime de Corinthe</data>
      <data key="n_sectors"></data>
      <data key="n_n_directors">23</data>
      <data key="n_territory">Grèce</data>
    </node>
    <node id="usineslaurium">
      <data key="n_label">Usines du Laurium</data>
      <data key="n_sectors"></data>
      <data key="n_n_directors">6</data>
      <data key="n_territory">Grèce</data>
    </node>
    <edge id="e0" source="canalcorinthe" target="internationale">
      <data key="e_weight">1</data>
    </edge>
    <edge id="e1" source="canalcorinthe" target="usineslaurium">
      <data key="e_weight">1</data>
    </edge>
  </graph>
</graphml>
