    </edge>
    <edge id="e7" source="colonialebambaobambao" target="etablissementsantoinechirisproduitsaromatiqueschimiques">
      <data key="e_weight">1</data>
    </edge>
    <edge id="e8" source="colonialebambaobambao" target="grandecomore">
