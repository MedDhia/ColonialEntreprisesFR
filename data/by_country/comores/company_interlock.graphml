      <data key="n_sectors">Documents généraux; Sociétés</data>
      <data key="n_n_directors">9</data>
      <data key="n_territory">Comores</data>
    </node>
    <edge id="e0" source="colonialebambao" target="colonialebambaobambao">
      <data key="e_weight">6</data>
    </edge>
    <edge id="e1" source="colonialebambao" target="etablissementsantoinechirisproduitsaromatiqueschimiques">
      <data key="e_weight">3</data>
    </edge>
    <edge id="e2" source="colonialebambao" target="grandecomore">
      <data key="e_weight">3</data>
    </edge>
    <edge id="e3" source="civilefomboni" target="colonialebambao">
      <data key="e_weight">1</data>
    </edge>
