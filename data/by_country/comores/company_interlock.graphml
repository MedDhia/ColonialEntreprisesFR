    </edge>
    <edge id="e5" source="civilefomboni" target="grandecomore">
      <data key="e_weight">1</data>
    </edge>
    <edge id="e6" source="etablissementsantoinechirisproduitsaromatiqueschimiques" target="grandecomore">
