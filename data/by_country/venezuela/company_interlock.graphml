<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="n_label" for="node" attr.name="label" attr.type="string"/>
  <key id="n_sectors" for="node" attr.name="sectors" attr.type="string"/>
  <key id="n_n_directors" for="node" attr.name="n_directors" attr.type="long"/>
  <key id="n_territory" for="node" attr.name="territory" attr.type="string"/>
  <key id="e_weight" for="edge" attr.name="weight" attr.type="long"/>
  <graph id="G" edgedefault="undirected">
    <node id="barthelemyrobaglia">
      <data key="n_label">Barthélémy Robaglia</data>
      <data key="n_sectors"></data>
      <data key="n_n_directors">5</data>
      <data key="n_territory">Venezuela</data>
    </node>
    <node id="mocupia">
      <data key="n_label">Compagnie française de la Mocupia, puis Mocupia</data>
      <data key="n_sectors"></data>
      <data key="n_n_directors">14</data>
      <data key="n_territory">Venezuela</data>
    </node>
    <edge id="e0" source="barthelemyrobaglia" target="mocupia">
      <data key="e_weight">5</data>
    </edge>
  </graph>
</graphml>
