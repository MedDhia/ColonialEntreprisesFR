<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="n_label" for="node" attr.name="label" attr.type="string"/>
  <key id="n_sectors" for="node" attr.name="sectors" attr.type="string"/>
  <key id="n_n_directors" for="node" attr.name="n_directors" attr.type="long"/>
  <key id="n_territory" for="node" attr.name="territory" attr.type="string"/>
  <key id="e_weight" for="edge" attr.name="weight" attr.type="long"/>
  <graph id="G" edgedefault="undirected">
    <node id="cheminsferdahomey">
      <data key="n_label">Cie française de chemins de fer du Dahomey</data>
      <data key="n_sectors"></data>
      <data key="n_n_directors">5</data>
      <data key="n_territory">Dahomey (Bénin)</data>
    </node>
    <node id="cheminsferdahomeyoucentraldahomeen">
      <data key="n_label">Compagnie française de Chemins de fer au Dahomey ou Central-Dahoméen</data>
      <data key="n_sectors"></data>
      <data key="n_n_directors">22</data>
      <data key="n_territory">Dahomey (Bénin)</data>
    </node>
    <node id="comptoirsreunisouestafricain">
      <data key="n_label">Comptoirs réunis de l'Ouest-Africain</data>
      <data key="n_sectors"></data>
      <data key="n_n_directors">17</data>
      <data key="n_territory">Dahomey (Bénin)</data>
    </node>
    <node id="raymondbuurmans">
      <data key="n_label">Raymond Buurmans</data>
      <data key="n_sectors"></data>
      <data key="n_n_directors">9</data>
      <data key="n_territory">Dahomey (Bénin)</data>
    </node>
    <edge id="e0" source="comptoirsreunisouestafricain" target="raymondbuurmans">
      <data key="e_weight">8</data>
    </edge>
    <edge id="e1" source="cheminsferdahomey" target="cheminsferdahomeyoucentraldahomeen">
      <data key="e_weight">1</data>
    </edge>
  </graph>
</graphml>
