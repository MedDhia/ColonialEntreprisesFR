<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="n_label" for="node" attr.name="label" attr.type="string"/>
  <key id="n_sectors" for="node" attr.name="sectors" attr.type="string"/>
  <key id="n_n_directors" for="node" attr.name="n_directors" attr.type="long"/>
  <key id="n_territory" for="node" attr.name="territory" attr.type="string"/>
  <key id="e_weight" for="edge" attr.name="weight" attr.type="long"/>
  <graph id="G" edgedefault="undirected">
    <node id="etainskinta">
      <data key="n_label">Société des Étains de Kinta</data>
      <data key="n_sectors">Sociétés françaises ou à participation française</data>
      <data key="n_n_directors">26</data>
      <data key="n_territory">Malaisie</data>
    </node>
    <node id="etainsmalaisie">
      <data key="n_label">Étains de Malaisie</data>
      <data key="n_sectors">Sociétés françaises ou à participation française</data>
      <data key="n_n_directors">8</data>
      <data key="n_territory">Malaisie</data>
    </node>
    <node id="kualalumpurrubbercompanyltd">
      <data key="n_label">The Kuala Lumpur Rubber Company Ltd</data>
      <data key="n_sectors">Sociétés françaises ou à participation française</data>
      <data key="n_n_directors">7</data>
      <data key="n_territory">Malaisie</data>
    </node>
    <node id="minesetainperak">
      <data key="n_label">Société des Mines d'étain de Pérak</data>
      <data key="n_sectors">Sociétés françaises ou à participation française</data>
      <data key="n_n_directors">7</data>
      <data key="n_territory">Malaisie</data>
    </node>
    <node id="tandjongmalimrubbercoutanjongmalimrubberc">
      <data key="n_label">Tandjong Malim Rubber C° ou Tanjong Malim Rubber C°</data>
      <data key="n_sectors">Sociétés françaises ou à participation française</data>
      <data key="n_n_directors">16</data>
      <data key="n_territory">Malaisie</data>
    </node>
    <edge id="e0" source="etainskinta" target="etainsmalaisie">
      <data key="e_weight">5</data>
    </edge>
    <edge id="e1" source="etainskinta" target="minesetainperak">
      <data key="e_weight">1</data>
    </edge>
    <edge id="e2" source="etainsmalaisie" target="minesetainperak">
      <data key="e_weight">1</data>
    </edge>
    <edge id="e3" source="kualalumpurrubbercompanyltd" target="tandjongmalimrubbercoutanjongmalimrubberc">
      <data key="e_weight">1</data>
    </edge>
  </graph>
</graphml>
