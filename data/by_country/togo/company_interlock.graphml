<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="n_label" for="node" attr.name="label" attr.type="string"/>
  <key id="n_sectors" for="node" attr.name="sectors" attr.type="string"/>
  <key id="n_n_directors" for="node" attr.name="n_directors" attr.type="long"/>
  <key id="n_territory" for="node" attr.name="territory" attr.type="string"/>
  <key id="e_weight" for="edge" attr.name="weight" attr.type="long"/>
  <graph id="G" edgedefault="undirected">
    <node id="cotonniereouestafricaine">
      <data key="n_label">Compagnie cotonnière ouest-africaine</data>
      <data key="n_sectors">Agriculture</data>
      <data key="n_n_directors">6</data>
      <data key="n_territory">Togo</data>
    </node>
    <node id="golfeguinee">
      <data key="n_label">Société générale du Golfe de Guinée</data>
      <data key="n_sectors">Commerce</data>
      <data key="n_n_directors">16</data>
      <data key="n_territory">Togo</data>
    </node>
    <edge id="e0" source="cotonniereouestafricaine" target="golfeguinee">
      <data key="e_weight">1</data>
    </edge>
  </graph>
</graphml>
